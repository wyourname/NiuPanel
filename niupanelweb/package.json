{
  "name": "niupanelweb",
  "version": "2.0.0",
  "description": "Vue web and mobile interface for NiuPanel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyourname/NiuPanel.git",
    "directory": "niupanelweb"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:file-scroll-ui": "node scripts/verify-file-scroll-ui.mjs",
    "verify:plugin-host-contract": "node scripts/verify-plugin-host-contract.mjs",
    "verify:plugin-route-contract": "node scripts/verify-plugin-route-contract.mjs",
    "verify:public-build": "node scripts/verify-public-build.mjs",
    "verify:ui-design-system": "node scripts/verify-ui-design-system.mjs",
    "preview": "vite preview",
    "static": "vite build --base=./",
    "cap:sync": "pnpm exec cap sync",
    "android:open": "pnpm exec cap open android",
    "ios:open": "pnpm exec cap open ios",
    "app:build": "pnpm run build && pnpm exec cap sync",
    "sync:win": "mkdir -p /mnt/d/VSCodeProject/niupanel-web/ && rsync -av --delete --exclude='node_modules/.vite' --exclude='node_modules/.cache' . /mnt/d/VSCodeProject/niupanel-web/"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@unocss/preset-attributify": "^66.5.10",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-uno": "^66.5.10",
    "@vueuse/core": "^14.1.0",
    "ansi_up": "^6.0.6",
    "axios": "^1.13.2",
    "chroma-js": "^3.2.0",
    "cron-parser": "^5.4.0",
    "cronstrue": "^3.9.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.9",
    "lodash-es": "^4.18.1",
    "monaco-editor": "0.53.0",
    "pinia": "^3.0.4",
    "unocss": "^66.5.10",
    "vue": "^3.5.25",
    "vue-clipboard3": "^2.0.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.3",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.15",
    "@iconify-json/ep": "^1.2.3",
    "@iconify-json/logos": "^1.2.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/shared": "^3.5.25",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.8"
  }
}
