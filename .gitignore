/release_tools/
/magisk/tools/
/docker/*.tar.gz
*.tar.gz
*.zip
.pnpm-store/

# Private plugin release assets belong to the NiuPanelPrivatePlugins repository.
/plugins/*.tgz
/plugins/niupanel-private-plugins.json

# Python and native build artifacts
.venv/
__pycache__/
*.py[cod]
*.so

# Test and coverage output
coverage/
*.profraw
*.profdata
