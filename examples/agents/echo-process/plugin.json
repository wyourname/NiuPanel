{
  "schema_version": 1,
  "id": "echo-process",
  "name": "Echo Process Agent",
  "version": "0.1.0",
  "domain": "debug",
  "description": "Minimal process agent that echoes the invoke payload.",
  "license": "Apache-2.0",
  "runtime": "process",
  "entry": "main.js",
  "args": [],
  "env": {},
  "timeout_sec": 10,
  "worker": { "min": 1, "max": 2, "idle_timeout_sec": 300 },
  "capability_level": "read_only",
  "capabilities": ["debug.echo"],
  "tools": [
    {
      "name": "echo",
      "description": "Echoes the request input.",
      "access": "read"
    }
  ],
  "model": {
    "required": false,
    "providers": ["openai_compatible"]
  }
}
