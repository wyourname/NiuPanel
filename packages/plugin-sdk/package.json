{
  "name": "@niupanel/plugin-sdk",
  "version": "0.1.0",
  "description": "TypeScript contracts and helpers for NiuPanel plugin applications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyourname/NiuPanel.git",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
