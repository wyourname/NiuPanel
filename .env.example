# Core HTTP listener
SERVER_ADDR=0.0.0.0:7788

# SQLite database used by both the launcher and the core service
DATABASE_URL=sqlite://data/database/niupanel.db?mode=rwc
# Keep one connection on small installations. Increase only for measured
# high-concurrency workloads; SQLite still runs in WAL + FULL mode.
DATABASE_MAX_CONNECTIONS=1
SQLITE_BUSY_TIMEOUT_MS=5000

# Leave empty to generate and persist a unique key automatically.
# To provide one explicitly: openssl rand -base64 64
SESSION_KEY=

# Optional runtime paths
SCRIPTS_DIR=data/scripts
JOBS_DIR=data/jobs
LOGS_DIR=data/logs
RUNTIMES_DIR=data/runtimes
PLUGINS_DIR=data/plugins
SYSTEM_DIR=data/system

# Domestic runtime/package mirrors
PNPM_NODE_DIST_MIRROR=https://mirrors.ustc.edu.cn/node/
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com/

# Security defaults
PLUGIN_SIGNATURE_REQUIRED=true
# Optional: enable MCP Host validation with a comma-separated allowlist.
# MCP_ALLOWED_HOSTS=panel.example.com,localhost,127.0.0.1,::1
CORS_ALLOWED_ORIGINS=
# Only these direct proxy peers may supply X-Forwarded-For / X-Real-IP.
TRUSTED_PROXIES=127.0.0.1,::1
# Set true when NiuPanel is served exclusively through HTTPS.
SESSION_COOKIE_SECURE=false

# Logging
LOG_LEVEL=warn
LOG_FILTERS=
