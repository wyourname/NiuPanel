{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niupanel.local/schemas/plugin.schema.json",
  "title": "NiuPanel Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "runtime"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": ["string", "null"],
      "description": "SPDX license expression for the plugin package."
    },
    "runtime": {
      "type": "string",
      "enum": ["builtin", "declarative", "process", "wasi", "native"]
    },
    "protocol": {
      "type": "string",
      "enum": ["single_shot", "json_lines"]
    },
    "entry": {
      "type": ["string", "null"]
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!(NIUPANEL_|LD_|DYLD_|DATABASE_URL$|HOME$|PATH$|TMPDIR$|BASH_ENV$|ENV$|SHELLOPTS$))[A-Za-z_][A-Za-z0-9_]{0,127}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtime_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["network_outbound"]
      }
    },
    "timeout_sec": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "idle_timeout_sec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*(\\.\\*)?$"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "domain": {
      "type": "string"
    },
    "capability_level": {
      "type": "string",
      "enum": ["read_only", "draft", "execute"]
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_version": {
              "type": ["string", "null"]
            },
            "max_version": {
              "type": ["string", "null"]
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
              },
              "min_version": {
                "type": ["string", "null"]
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": ["vue_app"]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": ["string", "null"]
        },
        "display": {
          "$ref": "#/$defs/uiDisplay"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiRoute"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api": {
          "$ref": "#/$defs/uiApi"
        }
      }
    },
    "uiDisplay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidebar": {
          "type": "boolean"
        },
        "workspace": {
          "type": "boolean"
        },
        "mobile": {
          "type": "boolean"
        },
        "category": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer"
        },
        "layout": {
          "type": "string",
          "enum": ["panel", "full_bleed"]
        }
      }
    },
    "uiRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/plugins/"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "icon": {
          "type": ["string", "null"]
        },
        "menu": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "uiApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiApiRule"
          }
        }
      }
    },
    "uiApiRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?!\\*\\*$)"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "light": {
          "$ref": "#/$defs/themePalette"
        },
        "dark": {
          "$ref": "#/$defs/themePalette"
        }
      }
    },
    "themePalette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/themeColor" },
        "bg_base": { "$ref": "#/$defs/themeColor" },
        "bg_card": { "$ref": "#/$defs/themeColor" },
        "bg_subtle": { "$ref": "#/$defs/themeColor" },
        "bg_soft": { "$ref": "#/$defs/themeColor" },
        "text_default": { "$ref": "#/$defs/themeColor" },
        "text_secondary": { "$ref": "#/$defs/themeColor" },
        "text_muted": { "$ref": "#/$defs/themeColor" },
        "border_base": { "$ref": "#/$defs/themeColor" },
        "border_light": { "$ref": "#/$defs/themeColor" }
      }
    },
    "themeColor": {
      "type": ["string", "null"],
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    }
  }
}
