# Core HTTP listener
SERVER_ADDR=0.0.0.0:7788

# SQLite database used by both the launcher and the core service
DATABASE_URL=sqlite://data/database/niupanel.db?mode=rwc

# Generate a unique value for every deployment. Do not commit the real key.
# Example: openssl rand -base64 64
SESSION_KEY=replace-with-a-random-session-key

# Optional runtime paths
SCRIPTS_DIR=data/scripts
JOBS_DIR=data/jobs
LOGS_DIR=data/logs
RUNTIMES_DIR=data/runtimes
PLUGINS_DIR=data/plugins
SYSTEM_DIR=data/system

# Security defaults
PLUGIN_SIGNATURE_REQUIRED=true
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
CORS_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=info
LOG_FILTERS=
